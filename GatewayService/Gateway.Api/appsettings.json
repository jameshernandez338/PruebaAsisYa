{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Yarp.ReverseProxy": "Debug",
      "ReverseProxy": "Debug"
    }
  },

  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },

      "provider-route": {
        "ClusterId": "provider-cluster",
        "Match": {
          "Path": "/providers/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth1": {
            "Address": "https://localhost:7195/"
          }
        }
      },

      "provider-cluster": {
        "Destinations": {
          "provider1": {
            "Address": "https://localhost:7031/"
          }
        }
      }
    }
  }
}